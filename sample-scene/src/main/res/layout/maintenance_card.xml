<?xml version="1.0" encoding="utf-8"?>
<!-- Sizes in px: the panel maps 1000 px to 1 m, so 20px text is 2 cm, about 20 display pixels at 1.5 m.
     The display is see-through: black is transparent, so the card has no background, only a frame. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_frame"
    android:orientation="horizontal"
    android:padding="16px"
    tools:ignore="PxUsage">

    <ImageView
        android:layout_width="96px"
        android:layout_height="96px"
        android:layout_marginEnd="16px"
        android:contentDescription="@null"
        android:src="@drawable/gauge" />

    <LinearLayout
        android:layout_width="0px"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sea water pump #02"
            android:textColor="#FFFFFF"
            android:textSize="26px"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6px"
            android:text="Seal inspected. Minor vibration detected."
            android:textColor="#E0E0E0"
            android:textSize="20px"
            tools:ignore="HardcodedText" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6px"
            android:text="Next check: 250 h"
            android:textColor="#FFD54F"
            android:textSize="20px"
            tools:ignore="HardcodedText" />
    </LinearLayout>
</LinearLayout>

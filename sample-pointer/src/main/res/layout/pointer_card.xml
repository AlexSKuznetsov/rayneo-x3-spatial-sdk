<?xml version="1.0" encoding="utf-8"?>
<!-- Sizes in px: the panel maps 1000 px to 1 m. Black is transparent on the see-through display. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_frame"
    android:orientation="vertical"
    android:padding="16px"
    tools:ignore="PxUsage,HardcodedText">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sea water pump #02"
        android:textColor="#FFFFFF"
        android:textSize="26px"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6px"
        android:text="Not inspected"
        android:textColor="#E0E0E0"
        android:textSize="20px" />

    <TextView
        android:id="@+id/live"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4px"
        android:fontFamily="monospace"
        android:text="Running 0.0 s"
        android:textColor="#80CBC4"
        android:textSize="18px" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14px"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/inspect"
            android:layout_width="0px"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="12px"
            android:background="@drawable/button_frame"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:padding="12px"
            android:text="Mark inspected"
            android:textColor="#FFD54F"
            android:textSize="20px" />

        <TextView
            android:id="@+id/reset"
            android:layout_width="0px"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/button_frame"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:padding="12px"
            android:text="Reset"
            android:textColor="#FFD54F"
            android:textSize="20px" />
    </LinearLayout>
</LinearLayout>
